/* Lettera inspector theme. Variables are overridden for the light editor skin by .lt--light. */

.lt-root {
    --lt-accent: #9b6dff;
    --lt-accent-soft: rgba(155, 109, 255, 0.18);
    --lt-accent-strong: rgba(155, 109, 255, 0.4);
    --lt-card: rgba(255, 255, 255, 0.035);
    --lt-card-hover: rgba(255, 255, 255, 0.065);
    --lt-border: rgba(255, 255, 255, 0.08);
    --lt-inset: rgba(0, 0, 0, 0.24);
    --lt-text: #e8e6ee;
    --lt-dim: rgba(232, 230, 238, 0.58);
    --lt-faint: rgba(232, 230, 238, 0.3);
    --lt-green: #3ecf8e;
    --lt-orange: #f5a524;
    --lt-red: #f06272;
    margin-top: 4px;
    margin-right: 2px;
}

.lt-root.lt--light {
    --lt-accent: #6d3ff0;
    --lt-accent-soft: rgba(109, 63, 240, 0.13);
    --lt-accent-strong: rgba(109, 63, 240, 0.3);
    --lt-card: rgba(0, 0, 0, 0.035);
    --lt-card-hover: rgba(0, 0, 0, 0.065);
    --lt-border: rgba(0, 0, 0, 0.11);
    --lt-inset: rgba(0, 0, 0, 0.08);
    --lt-text: #1f1c28;
    --lt-dim: rgba(31, 28, 40, 0.62);
    --lt-faint: rgba(31, 28, 40, 0.36);
}

/* ---------- Header ---------- */

.lt-header {
    flex-direction: row;
    align-items: center;
    padding: 8px;
    border-radius: 8px;
    background-color: var(--lt-card);
    border-width: 1px;
    border-color: var(--lt-border);
}

.lt-mark {
    width: 40px;
    height: 40px;
    border-radius: 9px;
    flex-shrink: 0;
    background-color: var(--lt-accent);
    color: #ffffff;
    font-size: 21px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

.lt-header__info {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 10px;
    min-width: 0;
}

.lt-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--lt-text);
    padding: 0;
    margin: 0;
}

.lt-subtitle {
    color: var(--lt-dim);
    font-size: 11px;
    margin: 1px 0 0 0;
    padding: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.lt-chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 5px;
}

.lt-chip {
    padding: 1px 7px;
    margin: 0 4px 3px 0;
    border-radius: 9px;
    font-size: 10px;
    background-color: var(--lt-inset);
    color: var(--lt-dim);
}

.lt-chip--accent { color: var(--lt-accent); background-color: var(--lt-accent-soft); }
.lt-chip--green { color: var(--lt-green); background-color: rgba(62, 207, 142, 0.14); }
.lt-chip--orange { color: var(--lt-orange); background-color: rgba(245, 165, 36, 0.14); }

/* ---------- Editor card: tag toolbar over the text field ---------- */

.lt-editor {
    margin-top: 6px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--lt-border);
    background-color: var(--lt-card);
    overflow: hidden;
}

.lt-toolbar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding: 3px 4px;
    border-bottom-width: 1px;
    border-color: var(--lt-border);
}

.lt-tool {
    min-width: 24px;
    height: 22px;
    padding: 0 5px;
    margin: 0 1px;
    border-radius: 5px;
    color: var(--lt-dim);
    font-size: 12px;
    -unity-text-align: middle-center;
}

.lt-tool:hover { background-color: var(--lt-card-hover); color: var(--lt-text); }
.lt-tool:active { background-color: var(--lt-accent-soft); color: var(--lt-accent); }
.lt-tool--bold { -unity-font-style: bold; }
.lt-tool--italic { -unity-font-style: italic; }

.lt-tool-gap {
    width: 1px;
    height: 14px;
    margin: 0 4px;
    background-color: var(--lt-border);
}

.lt-text-input { margin: 0; }

.lt-text-input > .unity-base-text-field__input {
    min-height: 62px;
    border-width: 0;
    border-radius: 0;
    background-color: transparent;
    padding: 6px 8px;
    color: var(--lt-text);
    white-space: normal;
    -unity-text-align: upper-left;
}

/* ---------- Tabs ---------- */

.lt-tabs {
    flex-direction: row;
    margin-top: 6px;
    padding: 3px;
    border-radius: 8px;
    background-color: var(--lt-inset);
}

.lt-tab {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    height: 26px;
    border-radius: 6px;
    color: var(--lt-dim);
}

.lt-tab:hover { background-color: var(--lt-card-hover); }
.lt-tab--active, .lt-tab--active:hover { background-color: var(--lt-accent); }

.lt-tab__label {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--lt-dim);
    padding: 0;
    margin: 0;
}

.lt-tab:hover .lt-tab__label { color: var(--lt-text); }
.lt-tab--active .lt-tab__label, .lt-tab--active:hover .lt-tab__label { color: #ffffff; }

.lt-tab__badge {
    font-size: 9px;
    margin-left: 5px;
    padding: 0 5px;
    border-radius: 7px;
    background-color: rgba(0, 0, 0, 0.25);
    color: var(--lt-dim);
}

.lt-tab--active .lt-tab__badge { color: #ffffff; }

.lt-page { margin-top: 6px; }

/* ---------- Cards and rows ---------- */

.lt-card {
    border-radius: 8px;
    background-color: var(--lt-card);
    border-width: 1px;
    border-color: var(--lt-border);
    margin-bottom: 6px;
    padding: 7px 8px 5px 8px;
}

.lt-card__title {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--lt-faint);
    margin: 0 0 5px 0;
    padding: 0;
}

.lt-row {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
    margin-bottom: 3px;
}

.lt-row__label {
    width: 34%;
    min-width: 76px;
    flex-shrink: 0;
    color: var(--lt-dim);
    font-size: 11px;
    padding: 0;
    margin: 0;
}

.lt-row__field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
}

.lt-row__field > .unity-base-field__label { display: none; }

.lt-row__field .unity-base-text-field__input,
.lt-row__field .unity-base-popup-field__input,
.lt-row__field .unity-object-field__input,
.lt-row__field .unity-color-field__input {
    border-radius: 5px;
    border-width: 1px;
    border-color: var(--lt-border);
    background-color: var(--lt-inset);
    min-height: 20px;
}

.lt-hint {
    color: var(--lt-dim);
    font-size: 10px;
    white-space: normal;
    margin: 0 0 4px 0;
    padding: 0;
}

.lt-note {
    border-radius: 6px;
    padding: 5px 8px;
    margin-bottom: 6px;
    font-size: 11px;
    white-space: normal;
    color: var(--lt-orange);
    background-color: rgba(245, 165, 36, 0.12);
}

/* ---------- Segmented controls ---------- */

.lt-seg {
    flex-direction: row;
    flex-grow: 1;
    padding: 2px;
    border-radius: 6px;
    background-color: var(--lt-inset);
}

.lt-seg__item {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    height: 22px;
    justify-content: center;
    align-items: center;
    border-radius: 4px;
    color: var(--lt-dim);
    font-size: 10px;
    -unity-text-align: middle-center;
    padding: 0 2px;
    margin: 0;
    overflow: hidden;
}

.lt-seg__item:hover { background-color: var(--lt-card-hover); color: var(--lt-text); }
.lt-seg__item--on, .lt-seg__item--on:hover { background-color: var(--lt-accent); color: #ffffff; }

/* ---------- Switches ---------- */

.lt-switch {
    width: 30px;
    height: 16px;
    border-radius: 8px;
    background-color: var(--lt-inset);
    border-width: 1px;
    border-color: var(--lt-border);
    flex-shrink: 0;
}

.lt-switch__knob {
    position: absolute;
    width: 12px;
    height: 12px;
    top: 1px;
    left: 1px;
    border-radius: 6px;
    background-color: var(--lt-dim);
}

.lt-switch--on { background-color: var(--lt-accent); border-color: var(--lt-accent); }
.lt-switch--on .lt-switch__knob { left: 15px; background-color: #ffffff; }

.lt-size-row { flex-direction: row; align-items: center; flex-grow: 1; }
.lt-size-row__slider { flex-grow: 1; margin: 0 6px 0 0; }
.lt-size-row__value { width: 52px; flex-shrink: 0; margin: 0; }

/* ---------- Padding box ---------- */

.lt-padding { flex-direction: row; flex-grow: 1; }
.lt-padding__cell { flex-grow: 1; flex-basis: 0; min-width: 0; margin: 0 2px 0 0; }
.lt-padding__cell > Label { min-width: 12px; width: 12px; font-size: 10px; color: var(--lt-faint); padding: 0; margin: 0 2px 0 2px; }

/* ---------- Style cards ---------- */

.lt-style {
    border-radius: 8px;
    background-color: var(--lt-card);
    border-width: 1px;
    border-color: var(--lt-border);
    margin-bottom: 5px;
    overflow: hidden;
}

.lt-style--off { opacity: 0.55; }

.lt-style__header {
    flex-direction: row;
    align-items: center;
    padding: 5px 6px 5px 8px;
}

.lt-style__header:hover { background-color: var(--lt-card-hover); }

.lt-style__tag {
    color: var(--lt-accent);
    -unity-font-style: bold;
    font-size: 11px;
    margin: 0 6px 0 8px;
    padding: 0;
    flex-shrink: 0;
}

.lt-style__type {
    color: var(--lt-dim);
    font-size: 11px;
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
    padding: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

.lt-style__body {
    padding: 4px 8px 4px 8px;
    border-top-width: 1px;
    border-color: var(--lt-border);
}

.lt-icon-btn {
    width: 20px;
    height: 20px;
    border-radius: 4px;
    color: var(--lt-dim);
    font-size: 13px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    padding: 0;
    margin: 0;
}

.lt-icon-btn:hover { background-color: var(--lt-card-hover); color: var(--lt-text); }
.lt-icon-btn--danger:hover { background-color: rgba(240, 98, 114, 0.2); color: var(--lt-red); }

.lt-add {
    height: 26px;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--lt-accent-strong);
    background-color: var(--lt-accent-soft);
    color: var(--lt-accent);
    -unity-font-style: bold;
    font-size: 11px;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
    padding: 0;
}

.lt-add:hover { background-color: var(--lt-accent-strong); }

.lt-vocab {
    flex-direction: row;
    flex-wrap: wrap;
}

.lt-vocab__tag {
    padding: 1px 6px;
    margin: 0 3px 3px 0;
    border-radius: 4px;
    font-size: 10px;
    color: var(--lt-dim);
    background-color: var(--lt-inset);
}

.lt-add-row {
    flex-direction: row;
    align-items: center;
}

.lt-add-row > .lt-add {
    flex-grow: 1;
    -unity-text-align: middle-center;
}

.lt-add-row > .lt-add--small {
    flex-grow: 0;
    margin: 0 0 0 4px;
    padding: 6px 12px;
    align-self: stretch;
}

.lt-icon-btn--text {
    width: auto;
    padding: 0 5px;
    font-size: 10px;
}

.lt-add--small {
    margin: 4px 0;
    padding: 2px 8px;
    font-size: 10px;
    align-self: flex-start;
    -unity-text-align: middle-left;
}

.lt-paint {
    margin: 2px 0 6px 0;
    padding-left: 6px;
    border-left-width: 2px;
    border-left-color: rgba(120, 160, 255, 0.45);
}

.lt-gradient {
    margin: 2px 0;
}

.lt-gradient__bar {
    height: 14px;
    margin: 2px 0 4px 0;
    border-radius: 3px;
    -unity-background-scale-mode: stretch-to-fill;
}

.lt-gradient__stop {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.lt-budget {
    flex-direction: row;
    align-items: center;
}

.lt-budget > .lt-row {
    flex-grow: 1;
}

.lt-row__value {
    -unity-text-align: middle-left;
    opacity: 0.85;
}

.lt-picker {
    padding: 6px;
}

.lt-picker__search {
    margin-bottom: 6px;
}

.lt-picker__group {
    margin-top: 8px;
    font-size: 10px;
    -unity-font-style: bold;
    opacity: 0.6;
}

.lt-picker__kind {
    margin: 4px 0 2px 4px;
    font-size: 10px;
    opacity: 0.5;
}

.lt-picker__item {
    flex-direction: row;
    justify-content: space-between;
    padding: 3px 8px;
    border-radius: 3px;
}

.lt-picker__item:hover {
    background-color: rgba(120, 160, 255, 0.25);
}

.lt-picker__keys {
    opacity: 0.55;
    font-size: 10px;
}

/* ---------------------------------------------------- toolkit of 1.0 */

.lt-section__header {
    flex-direction: row;
    align-items: center;
    min-height: 20px;
    margin-bottom: 2px;
}

.lt-section__chevron {
    width: 14px;
    color: rgba(255, 255, 255, 0.45);
    -unity-font-style: normal;
}

.lt-section__title {
    margin: 0;
    padding: 0;
    flex-shrink: 0;
}

.lt-section__summary {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 8px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-align: middle-right;
    color: rgba(255, 255, 255, 0.45);
    font-size: 11px;
}

.lt-number__label {
    cursor: resize-horizontal;
}

.lt-fix {
    flex-direction: row;
    align-items: center;
    padding: 4px 6px;
    margin: 2px 0;
    border-radius: 5px;
    background-color: rgba(255, 170, 60, 0.12);
    border-left-width: 2px;
    border-left-color: rgb(255, 170, 60);
}

.lt-fix__text {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    color: rgb(255, 200, 130);
    font-size: 11px;
}

.lt-fix__button {
    margin-left: 6px;
    padding: 1px 8px;
    border-radius: 4px;
    background-color: rgba(255, 170, 60, 0.25);
    color: rgb(255, 225, 190);
    font-size: 11px;
}

.lt-fix__button:hover {
    background-color: rgba(255, 170, 60, 0.4);
}

.lt-status__row {
    flex-direction: row;
    align-items: center;
    min-height: 18px;
}

.lt-status__dot {
    width: 6px;
    height: 6px;
    margin-right: 6px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.15);
}

.lt-status__dot--good { background-color: rgb(90, 200, 120); }
.lt-status__dot--warn { background-color: rgb(255, 170, 60); }
.lt-status__dot--bad { background-color: rgb(240, 90, 80); }

.lt-status__label {
    width: 40%;
    color: rgba(255, 255, 255, 0.55);
    font-size: 11px;
}

.lt-status__value {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 11px;
}

.lt-search {
    margin: 2px 0 6px 0;
}

.lt-popup {
    padding: 6px;
    flex-grow: 1;
}

.lt-box__summary {
    padding: 2px 6px;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.2);
}

.lt-box__summary:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

.lt-list__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.lt-list__title {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.6);
    margin-right: 6px;
}

.lt-list__space {
    flex-grow: 1;
}

.lt-list__row {
    border-left-width: 2px;
    border-left-color: rgba(0, 0, 0, 0);
    padding-left: 4px;
    margin-bottom: 2px;
    border-radius: 3px;
}

.lt-list__row--on {
    border-left-color: rgb(155, 110, 255);
    background-color: rgba(155, 110, 255, 0.1);
}

.lt-list__drop {
    height: 2px;
    margin: 1px 0;
    background-color: rgb(155, 110, 255);
}

.lt-jump {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 4px 0;
}

.lt-jump__item {
    padding: 2px 8px;
    margin: 0 4px 4px 0;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.06);
    font-size: 11px;
}

.lt-jump__item:hover {
    background-color: rgba(155, 110, 255, 0.3);
}

.lt-palette__row {
    flex-direction: row;
    align-items: center;
    padding: 3px 6px;
    border-radius: 4px;
}

.lt-palette__row--on {
    background-color: rgba(155, 110, 255, 0.28);
}

.lt-palette__name {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.lt-palette__group {
    margin-left: 6px;
    color: rgba(255, 255, 255, 0.4);
    font-size: 10px;
}

.lt--light .lt-section__chevron,
.lt--light .lt-section__summary,
.lt--light .lt-status__label,
.lt--light .lt-list__title,
.lt--light .lt-palette__group {
    color: rgba(0, 0, 0, 0.55);
}

.lt--light .lt-jump__item {
    background-color: rgba(0, 0, 0, 0.08);
}

.lt--light .lt-fix__text {
    color: rgb(130, 75, 10);
}
