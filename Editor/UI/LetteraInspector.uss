/* Lettera inspector theme. Variables are overridden for the light editor skin by .lt--light. */

.lt-root {
    --lt-accent: #9b6dff;
    --lt-accent-soft: rgba(155, 109, 255, 0.18);
    --lt-accent-strong: rgba(155, 109, 255, 0.4);
    --lt-card: rgba(255, 255, 255, 0.035);
    --lt-card-hover: rgba(255, 255, 255, 0.065);
    --lt-border: rgba(255, 255, 255, 0.08);
    --lt-inset: rgba(0, 0, 0, 0.24);
    --lt-text: #e8e6ee;
    --lt-dim: rgba(232, 230, 238, 0.58);
    --lt-faint: rgba(232, 230, 238, 0.3);
    --lt-green: #3ecf8e;
    --lt-orange: #f5a524;
    --lt-red: #f06272;
    margin-top: 4px;
    margin-right: 2px;
}

.lt-root.lt--light {
    --lt-accent: #6d3ff0;
    --lt-accent-soft: rgba(109, 63, 240, 0.13);
    --lt-accent-strong: rgba(109, 63, 240, 0.3);
    --lt-card: rgba(0, 0, 0, 0.035);
    --lt-card-hover: rgba(0, 0, 0, 0.065);
    --lt-border: rgba(0, 0, 0, 0.11);
    --lt-inset: rgba(0, 0, 0, 0.08);
    --lt-text: #1f1c28;
    --lt-dim: rgba(31, 28, 40, 0.62);
    --lt-faint: rgba(31, 28, 40, 0.36);
}

/* ---------- Header ---------- */

.lt-header {
    flex-direction: row;
    align-items: center;
    padding: 8px;
    border-radius: 8px;
    background-color: var(--lt-card);
    border-width: 1px;
    border-color: var(--lt-border);
}

.lt-mark {
    width: 40px;
    height: 40px;
    border-radius: 9px;
    flex-shrink: 0;
    background-color: var(--lt-accent);
    color: #ffffff;
    font-size: 21px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

.lt-header__info {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 10px;
    min-width: 0;
}

.lt-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--lt-text);
    padding: 0;
    margin: 0;
}

.lt-subtitle {
    color: var(--lt-dim);
    font-size: 11px;
    margin: 1px 0 0 0;
    padding: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.lt-chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 5px;
}

.lt-chip {
    padding: 1px 7px;
    margin: 0 4px 3px 0;
    border-radius: 9px;
    font-size: 10px;
    background-color: var(--lt-inset);
    color: var(--lt-dim);
}

.lt-chip--accent { color: var(--lt-accent); background-color: var(--lt-accent-soft); }
.lt-chip--green { color: var(--lt-green); background-color: rgba(62, 207, 142, 0.14); }
.lt-chip--orange { color: var(--lt-orange); background-color: rgba(245, 165, 36, 0.14); }

/* ---------- Editor card: tag toolbar over the text field ---------- */

.lt-editor {
    margin-top: 6px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--lt-border);
    background-color: var(--lt-card);
    overflow: hidden;
}

.lt-toolbar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding: 3px 4px;
    border-bottom-width: 1px;
    border-color: var(--lt-border);
}

.lt-tool {
    min-width: 24px;
    height: 22px;
    padding: 0 5px;
    margin: 0 1px;
    border-radius: 5px;
    color: var(--lt-dim);
    font-size: 12px;
    -unity-text-align: middle-center;
}

.lt-tool:hover { background-color: var(--lt-card-hover); color: var(--lt-text); }
.lt-tool:active { background-color: var(--lt-accent-soft); color: var(--lt-accent); }
.lt-tool--bold { -unity-font-style: bold; }
.lt-tool--italic { -unity-font-style: italic; }

.lt-tool-gap {
    width: 1px;
    height: 14px;
    margin: 0 4px;
    background-color: var(--lt-border);
}

.lt-text-input { margin: 0; }

.lt-text-input > .unity-base-text-field__input {
    min-height: 62px;
    border-width: 0;
    border-radius: 0;
    background-color: transparent;
    padding: 6px 8px;
    color: var(--lt-text);
    white-space: normal;
    -unity-text-align: upper-left;
}

/* ---------- Tabs ---------- */

.lt-tabs {
    flex-direction: row;
    margin-top: 6px;
    padding: 3px;
    border-radius: 8px;
    background-color: var(--lt-inset);
}

.lt-tab {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    height: 26px;
    border-radius: 6px;
    color: var(--lt-dim);
}

.lt-tab:hover { background-color: var(--lt-card-hover); }
.lt-tab--active, .lt-tab--active:hover { background-color: var(--lt-accent); }

.lt-tab__label {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--lt-dim);
    padding: 0;
    margin: 0;
}

.lt-tab:hover .lt-tab__label { color: var(--lt-text); }
.lt-tab--active .lt-tab__label, .lt-tab--active:hover .lt-tab__label { color: #ffffff; }

.lt-tab__badge {
    font-size: 9px;
    margin-left: 5px;
    padding: 0 5px;
    border-radius: 7px;
    background-color: rgba(0, 0, 0, 0.25);
    color: var(--lt-dim);
}

.lt-tab--active .lt-tab__badge { color: #ffffff; }

.lt-page { margin-top: 6px; }

/* ---------- Cards and rows ---------- */

.lt-card {
    border-radius: 8px;
    background-color: var(--lt-card);
    border-width: 1px;
    border-color: var(--lt-border);
    margin-bottom: 6px;
    padding: 7px 8px 5px 8px;
}

.lt-card__title {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--lt-faint);
    margin: 0 0 5px 0;
    padding: 0;
}

.lt-row {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
    margin-bottom: 3px;
}

.lt-row__label {
    width: 34%;
    min-width: 76px;
    flex-shrink: 0;
    color: var(--lt-dim);
    font-size: 11px;
    padding: 0;
    margin: 0;
}

.lt-row__field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
}

.lt-row__field > .unity-base-field__label { display: none; }

.lt-row__field .unity-base-text-field__input,
.lt-row__field .unity-base-popup-field__input,
.lt-row__field .unity-object-field__input,
.lt-row__field .unity-color-field__input {
    border-radius: 5px;
    border-width: 1px;
    border-color: var(--lt-border);
    background-color: var(--lt-inset);
    min-height: 20px;
}

.lt-hint {
    color: var(--lt-dim);
    font-size: 10px;
    white-space: normal;
    margin: 0 0 4px 0;
    padding: 0;
}

.lt-note {
    border-radius: 6px;
    padding: 5px 8px;
    margin-bottom: 6px;
    font-size: 11px;
    white-space: normal;
    color: var(--lt-orange);
    background-color: rgba(245, 165, 36, 0.12);
}

/* ---------- Segmented controls ---------- */

.lt-seg {
    flex-direction: row;
    flex-grow: 1;
    padding: 2px;
    border-radius: 6px;
    background-color: var(--lt-inset);
}

.lt-seg__item {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    height: 22px;
    justify-content: center;
    align-items: center;
    border-radius: 4px;
    color: var(--lt-dim);
    font-size: 10px;
    -unity-text-align: middle-center;
    padding: 0 2px;
    margin: 0;
    overflow: hidden;
}

.lt-seg__item:hover { background-color: var(--lt-card-hover); color: var(--lt-text); }
.lt-seg__item--on, .lt-seg__item--on:hover { background-color: var(--lt-accent); color: #ffffff; }

/* ---------- Switches ---------- */

.lt-switch {
    width: 30px;
    height: 16px;
    border-radius: 8px;
    background-color: var(--lt-inset);
    border-width: 1px;
    border-color: var(--lt-border);
    flex-shrink: 0;
}

.lt-switch__knob {
    position: absolute;
    width: 12px;
    height: 12px;
    top: 1px;
    left: 1px;
    border-radius: 6px;
    background-color: var(--lt-dim);
}

.lt-switch--on { background-color: var(--lt-accent); border-color: var(--lt-accent); }
.lt-switch.lt-row__field { flex-grow: 0; }
.lt-switch--on .lt-switch__knob { left: 15px; background-color: #ffffff; }

.lt-size-row { flex-direction: row; align-items: center; flex-grow: 1; }
.lt-size-row__slider { flex-grow: 1; margin: 0 6px 0 0; }
.lt-size-row__value { width: 52px; flex-shrink: 0; margin: 0; }

/* ---------- Padding box ---------- */

.lt-padding { flex-direction: row; flex-grow: 1; }
.lt-padding__cell { flex-grow: 1; flex-basis: 0; min-width: 0; margin: 0 2px 0 0; }
.lt-padding__cell > Label { min-width: 12px; width: 12px; font-size: 10px; color: var(--lt-faint); padding: 0; margin: 0 2px 0 2px; }

/* ---------- Style cards ---------- */

.lt-style {
    border-radius: 8px;
    background-color: var(--lt-card);
    border-width: 1px;
    border-color: var(--lt-border);
    margin-bottom: 5px;
    overflow: hidden;
}

.lt-style--off { opacity: 0.55; }

.lt-style__header {
    flex-direction: row;
    align-items: center;
    padding: 5px 6px 5px 8px;
}

.lt-style__header:hover { background-color: var(--lt-card-hover); }

.lt-style__tag {
    color: var(--lt-accent);
    -unity-font-style: bold;
    font-size: 11px;
    margin: 0 6px 0 8px;
    padding: 0;
    flex-shrink: 0;
}

.lt-style__type {
    color: var(--lt-dim);
    font-size: 11px;
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
    padding: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

.lt-style__body {
    padding: 4px 8px 4px 8px;
    border-top-width: 1px;
    border-color: var(--lt-border);
}

.lt-icon-btn {
    width: 20px;
    height: 20px;
    border-radius: 4px;
    color: var(--lt-dim);
    font-size: 13px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    padding: 0;
    margin: 0;
}

.lt-icon-btn:hover { background-color: var(--lt-card-hover); color: var(--lt-text); }
.lt-icon-btn--danger:hover { background-color: rgba(240, 98, 114, 0.2); color: var(--lt-red); }

.lt-add {
    height: 26px;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--lt-accent-strong);
    background-color: var(--lt-accent-soft);
    color: var(--lt-accent);
    -unity-font-style: bold;
    font-size: 11px;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
    padding: 0;
}

.lt-add:hover { background-color: var(--lt-accent-strong); }

.lt-vocab {
    flex-direction: row;
    flex-wrap: wrap;
}

.lt-vocab__tag {
    padding: 1px 6px;
    margin: 0 3px 3px 0;
    border-radius: 4px;
    font-size: 10px;
    color: var(--lt-dim);
    background-color: var(--lt-inset);
}

.lt-add-row {
    flex-direction: row;
    align-items: center;
}

.lt-add-row > .lt-add {
    flex-grow: 1;
    -unity-text-align: middle-center;
}

.lt-add-row > .lt-add--small {
    flex-grow: 0;
    margin: 0 0 0 4px;
    padding: 6px 12px;
    align-self: stretch;
}

.lt-icon-btn--text {
    width: auto;
    padding: 0 5px;
    font-size: 10px;
}

.lt-add--small {
    margin: 4px 0;
    padding: 2px 8px;
    font-size: 10px;
    align-self: flex-start;
    -unity-text-align: middle-left;
}

.lt-paint {
    margin: 2px 0 6px 0;
    padding-left: 6px;
    border-left-width: 2px;
    border-left-color: rgba(120, 160, 255, 0.45);
}

.lt-gradient {
    margin: 2px 0;
}

.lt-gradient__bar {
    height: 14px;
    margin: 2px 0 4px 0;
    border-radius: 3px;
    -unity-background-scale-mode: stretch-to-fill;
}

.lt-gradient__stop {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.lt-budget {
    flex-direction: row;
    align-items: center;
}

.lt-budget > .lt-row {
    flex-grow: 1;
}

.lt-row__value {
    -unity-text-align: middle-left;
    opacity: 0.85;
}

.lt-picker {
    padding: 6px;
}

.lt-picker__search {
    margin-bottom: 6px;
}

.lt-picker__group {
    margin-top: 8px;
    font-size: 10px;
    -unity-font-style: bold;
    opacity: 0.6;
}

.lt-picker__kind {
    margin: 4px 0 2px 4px;
    font-size: 10px;
    opacity: 0.5;
}

.lt-picker__item {
    flex-direction: row;
    justify-content: space-between;
    padding: 3px 8px;
    border-radius: 3px;
}

.lt-picker__item:hover {
    background-color: rgba(120, 160, 255, 0.25);
}

.lt-picker__keys {
    opacity: 0.55;
    font-size: 10px;
}

/* ---------------------------------------------------- toolkit of 1.0 */

.lt-section__header {
    flex-direction: row;
    align-items: center;
    min-height: 20px;
    margin-bottom: 2px;
}

.lt-section__chevron {
    width: 14px;
    color: rgba(255, 255, 255, 0.45);
    -unity-font-style: normal;
}

.lt-section__title {
    margin: 0;
    padding: 0;
    flex-shrink: 0;
}

.lt-section__summary {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 8px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-align: middle-right;
    color: rgba(255, 255, 255, 0.45);
    font-size: 11px;
}

.lt-number__label {
    cursor: resize-horizontal;
}

.lt-fix {
    flex-direction: row;
    align-items: center;
    padding: 4px 6px;
    margin: 2px 0;
    border-radius: 5px;
    background-color: rgba(255, 170, 60, 0.12);
    border-left-width: 2px;
    border-left-color: rgb(255, 170, 60);
}

.lt-fix__text {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    color: rgb(255, 200, 130);
    font-size: 11px;
}

.lt-fix__button {
    margin-left: 6px;
    padding: 1px 8px;
    border-radius: 4px;
    background-color: rgba(255, 170, 60, 0.25);
    color: rgb(255, 225, 190);
    font-size: 11px;
}

.lt-fix__button:hover {
    background-color: rgba(255, 170, 60, 0.4);
}

.lt-status__row {
    flex-direction: row;
    align-items: center;
    min-height: 18px;
}

.lt-status__dot {
    width: 6px;
    height: 6px;
    margin-right: 6px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.15);
}

.lt-status__dot--good { background-color: rgb(90, 200, 120); }
.lt-status__dot--warn { background-color: rgb(255, 170, 60); }
.lt-status__dot--bad { background-color: rgb(240, 90, 80); }

.lt-status__label {
    width: 40%;
    color: rgba(255, 255, 255, 0.55);
    font-size: 11px;
}

.lt-status__value {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 11px;
}

.lt-search {
    margin: 2px 0 6px 0;
}

.lt-popup {
    padding: 6px;
    flex-grow: 1;
}

.lt-box__summary {
    padding: 2px 6px;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.2);
}

.lt-box__summary:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

.lt-list__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.lt-list__title {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.6);
    margin-right: 6px;
}

.lt-list__space {
    flex-grow: 1;
}

.lt-list__row {
    border-left-width: 2px;
    border-left-color: rgba(0, 0, 0, 0);
    padding-left: 4px;
    margin-bottom: 2px;
    border-radius: 3px;
}

.lt-list__row--on {
    border-left-color: rgb(155, 110, 255);
    background-color: rgba(155, 110, 255, 0.1);
}

.lt-list__drop {
    height: 2px;
    margin: 1px 0;
    background-color: rgb(155, 110, 255);
}

.lt-jump {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 4px 0;
}

.lt-jump__item {
    padding: 2px 8px;
    margin: 0 4px 4px 0;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.06);
    font-size: 11px;
}

.lt-jump__item:hover {
    background-color: rgba(155, 110, 255, 0.3);
}

.lt-palette__row {
    flex-direction: row;
    align-items: center;
    padding: 3px 6px;
    border-radius: 4px;
}

.lt-palette__row--on {
    background-color: rgba(155, 110, 255, 0.28);
}

.lt-palette__name {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.lt-palette__group {
    margin-left: 6px;
    color: rgba(255, 255, 255, 0.4);
    font-size: 10px;
}

.lt--light .lt-section__chevron,
.lt--light .lt-section__summary,
.lt--light .lt-status__label,
.lt--light .lt-list__title,
.lt--light .lt-palette__group {
    color: rgba(0, 0, 0, 0.55);
}

.lt--light .lt-jump__item {
    background-color: rgba(0, 0, 0, 0.08);
}

.lt--light .lt-fix__text {
    color: rgb(130, 75, 10);
}

.lt-filtered {
    display: none;
}

/* A card inside a section is a group: its title stays, its frame goes. */
.lt-section__content .lt-card {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 2px 0 2px 0;
    margin: 0 0 4px 0;
}

.lt-tool--on {
    background-color: rgba(155, 110, 255, 0.45);
}

.lt-text-input--tall .unity-text-field__input,
.lt-text-input--tall #unity-text-input {
    min-height: 220px;
}

.lt-search .lt-text-input {
    min-height: 20px;
    height: 22px;
    margin: 0;
}

.lt-search #unity-text-input,
.lt-search .unity-text-field__input {
    min-height: 20px;
    height: 22px;
    padding: 1px 6px;
}

.lt-range {
    padding: 3px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.lt-glyph-row {
    padding: 1px 0;
}

.lt-glyph-row:hover {
    background-color: rgba(155, 110, 255, 0.15);
}

/* ---------- Sequencer window ---------- */

.lt-seq-page {
    flex-grow: 1;
}

.lt-seq-body {
    flex-grow: 1;
}

.lt-seq-time {
    margin: 0 8px;
    color: var(--lt-dim);
    font-size: 11px;
    -unity-text-align: middle-left;
    min-width: 92px;
}

.lt-seq-timeline {
    flex-direction: row;
    flex-grow: 1;
    min-height: 130px;
    margin: 4px 0;
    border-width: 1px;
    border-color: var(--lt-border);
    border-radius: 6px;
    overflow: hidden;
}

.lt-seq-gutter {
    width: 24px;
    flex-shrink: 0;
    overflow: hidden;
    background-color: var(--lt-inset);
}

.lt-seq-rowlabel {
    position: absolute;
    left: 0;
    right: 0;
    height: 26px;
    color: var(--lt-faint);
    font-size: 10px;
    -unity-text-align: middle-center;
}

.lt-seq-main {
    flex-grow: 1;
    flex-shrink: 1;
    width: 0;
}

.lt-seq-ruler {
    height: 22px;
    flex-shrink: 0;
    overflow: hidden;
    color: var(--lt-faint);
    background-color: var(--lt-inset);
}

.lt-seq-tick {
    position: absolute;
    top: 1px;
    color: var(--lt-dim);
    font-size: 9px;
}

.lt-seq-tracks {
    flex-grow: 1;
    overflow: hidden;
    color: var(--lt-border);
    background-color: var(--lt-card);
}

.lt-seq-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.lt-seq-cue {
    position: absolute;
    justify-content: center;
    overflow: hidden;
    border-width: 1px;
    border-radius: 4px;
    border-color: var(--lt-accent-strong);
    background-color: var(--lt-accent-soft);
}

.lt-seq-cue--on {
    border-color: var(--lt-accent);
    background-color: var(--lt-accent-strong);
    border-left-width: 3px;
    border-right-width: 3px;
}

.lt-seq-cue--muted {
    opacity: 0.4;
}

.lt-seq-cue--problem {
    border-color: var(--lt-orange);
}

.lt-seq-cue__label {
    margin: 0 4px;
    color: var(--lt-text);
    font-size: 10px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.lt-seq-head {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: var(--lt-red);
}

.lt-seq-snap {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background-color: var(--lt-green);
}

.lt-seq-marquee {
    position: absolute;
    border-width: 1px;
    border-color: var(--lt-accent);
    background-color: var(--lt-accent-soft);
}

.lt-seq-detail {
    flex-shrink: 0;
    max-height: 45%;
}

.lt-seq-detail .lt-text-input > .unity-base-text-field__input {
    min-height: 20px;
    padding: 1px 6px;
}

.lt-seq-status {
    padding: 2px 4px;
    color: var(--lt-dim);
    font-size: 10px;
}

/* ---------- Inspector of 1.0: the text page and its controls ---------- */

.lt-header--stack {
    flex-direction: column;
    align-items: stretch;
}

.lt-header__top {
    flex-direction: row;
    align-items: center;
}

.lt-warnings {
    margin-top: 2px;
}

.lt-tool, .lt-seg__item, .lt-switch, .lt-icon-btn, .lt-add, .lt-jump__item, .lt-chip--click, .lt-chip__part,
.lt-vocab__tag, .lt-object__button, .lt-object__name, .lt-enum__value, .lt-box__summary, .lt-fix__button,
.lt-palette__row, .lt-picker__item, .lt-picker__head, .lt-section__header, .lt-row--toggle {
    cursor: link;
}

.lt-chip--click:hover { color: var(--lt-text); background-color: var(--lt-accent-soft); }
.lt-chip--pair { flex-direction: row; padding: 0 3px 0 7px; }
.lt-chip__part { font-size: 10px; color: var(--lt-accent); padding: 1px 0; margin: 0; }
.lt-chip__remove { margin-left: 4px; padding: 1px 3px; color: var(--lt-dim); }
.lt-chip__remove:hover { color: var(--lt-red); }
.lt-chip__part:hover { color: var(--lt-text); }

.lt-jump-holder { margin: 6px 0 2px 0; }
.lt-jump { margin: 0 0 2px 0; }
.lt-jump__item { color: var(--lt-dim); font-size: 10px; background-color: var(--lt-inset); }
.lt-jump__item:hover { color: var(--lt-text); background-color: var(--lt-accent-soft); }

.lt-section__chevron, .lt-section__summary, .lt-list__title, .lt-palette__group, .lt-status__label { color: var(--lt-dim); }

/* Small fields everywhere, one high. The source field is the only tall one. */
.lt-text-input { margin: 0; }

.lt-text-input > .unity-base-text-field__input {
    min-height: 20px;
    padding: 1px 6px;
    border-radius: 5px;
    border-width: 1px;
    border-color: var(--lt-border);
    background-color: var(--lt-inset);
    color: var(--lt-text);
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.lt-source { margin: 0; }

.lt-source > .unity-base-text-field__input {
    min-height: 62px;
    border-width: 0;
    border-radius: 0;
    background-color: transparent;
    padding: 6px 8px;
    color: var(--lt-text);
    white-space: normal;
    -unity-text-align: upper-left;
}

.lt-source--tall > .unity-base-text-field__input { min-height: 220px; }

.lt-source__colors {
    position: absolute;
    margin: 0;
    padding: 0;
    color: var(--lt-text);
    white-space: normal;
    -unity-text-align: upper-left;
    overflow: hidden;
}

.lt-source-box { min-width: 0; }

.lt-source__shown-box { padding: 6px 8px; min-height: 62px; }
.lt-source__shown { white-space: normal; color: var(--lt-text); margin: 0; padding: 0; }
.lt-source__why { margin: 4px 8px; }
.lt-source__shown-box .lt-source__why { margin: 6px 0 0 0; }

.lt-toolbar--show { padding-bottom: 3px; }
.lt-tool--icon { align-items: center; justify-content: center; padding: 0; width: 24px; min-width: 24px; color: var(--lt-dim); }
.lt-tool--icon .lt-icon { color: var(--lt-dim); }
.lt-tool--icon:hover .lt-icon { color: var(--lt-text); }
.lt-tool--on, .lt-tool--on:hover { background-color: var(--lt-accent-soft); color: var(--lt-accent); }
.lt-tool--on .lt-icon, .lt-tool--on:hover .lt-icon { color: var(--lt-accent); }

.lt-source-modes { flex-grow: 1; flex-basis: 150px; min-width: 130px; margin: 0 4px; }
.lt-seg__item--over { color: var(--lt-orange); }
.lt-source-size { width: 54px; flex-shrink: 0; margin: 0 4px; min-width: 0; }

/* Rows that hold two things. */
.lt-row--pair { flex-wrap: wrap; }
.lt-row--pair > .lt-row { flex-grow: 1; flex-basis: 0; min-width: 110px; margin-bottom: 0; margin-right: 8px; }
.lt-row--pair > .lt-row > .lt-row__label { width: auto; min-width: 0; margin-right: 6px; flex-shrink: 0; }
.lt-auto-sizes { flex-direction: row; flex-grow: 1; flex-basis: 0; align-items: center; min-width: 170px; flex-wrap: wrap; }
.lt-auto-sizes > .lt-row { flex-grow: 1; flex-basis: 0; min-width: 72px; margin: 0 6px 0 0; }
.lt-auto-sizes > .lt-row > .lt-row__label { width: auto; min-width: 0; margin-right: 4px; flex-shrink: 0; }
.lt-auto-current { color: var(--lt-dim); font-size: 11px; margin: 0 6px 0 0; padding: 0; }

.lt-inline { flex-direction: row; align-items: center; margin-right: 8px; min-height: 22px; }
.lt-inline__label { color: var(--lt-dim); font-size: 11px; margin: 0 6px 0 0; padding: 0; }
.lt-switch-holder { flex-direction: row; align-items: center; }
.lt-switch--mixed .lt-switch__knob { left: 8px; }
.lt-row__label--override, .lt-inline__label.lt-row__label--override { -unity-font-style: bold; color: var(--lt-text); }
.lt-row--animated { background-color: var(--lt-accent-soft); border-radius: 4px; }

.lt-align { flex-direction: row; flex-wrap: wrap; flex-grow: 1; }
.lt-seg--icons { flex-grow: 0; margin: 0 6px 2px 0; }
.lt-seg--icons > .lt-seg__item { width: 25px; flex-grow: 0; flex-basis: auto; }

.lt-line-height { flex-direction: row; align-items: center; flex-grow: 1; flex-wrap: wrap; }
.lt-line-height > .lt-enum { flex-grow: 3; flex-basis: 0; min-width: 150px; margin: 0 6px 0 0; }
.lt-line-value { flex-grow: 1; flex-basis: 0; min-width: 44px; max-width: 70px; margin: 0; }

.lt-language { flex-direction: row; align-items: center; }
.lt-language__value { flex-grow: 1; flex-shrink: 1; min-width: 0; }

.lt-number__label { -unity-text-align: middle-left; }
.lt-budget { margin-bottom: 2px; }

/* A chosen value, in words. */
.lt-enum__value {
    min-height: 20px;
    padding: 2px 6px;
    border-radius: 5px;
    border-width: 1px;
    border-color: var(--lt-border);
    background-color: var(--lt-inset);
    color: var(--lt-text);
    font-size: 11px;
    -unity-text-align: middle-left;
    flex-grow: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.lt-enum__value:hover { background-color: var(--lt-card-hover); }
.lt-enum__value--changed { color: var(--lt-accent); }

.lt-object__slot {
    flex-direction: row;
    align-items: center;
    min-height: 20px;
    padding: 0 2px 0 4px;
    border-radius: 5px;
    border-width: 1px;
    border-color: var(--lt-border);
    background-color: var(--lt-inset);
    overflow: hidden;
}

.lt-object__icon { width: 14px; height: 14px; flex-shrink: 0; margin-right: 4px; }

.lt-object__name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    color: var(--lt-text);
    font-size: 11px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.lt-object__name--empty { color: var(--lt-faint); }

.lt-object__button {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    color: var(--lt-dim);
}

.lt-object__button .lt-icon { color: var(--lt-dim); }
.lt-object__button:hover { background-color: var(--lt-card-hover); }
.lt-object__button:hover .lt-icon { color: var(--lt-text); }

.lt-color__swatch { flex-grow: 1; flex-basis: 0; min-width: 40px; margin: 0 6px 0 0; }
.lt-color__swatch > .unity-base-field__label { display: none; }
.lt-color__hex { width: 76px; flex-shrink: 0; }

.lt-unit__value { flex-grow: 1; flex-basis: 0; min-width: 40px; margin-right: 6px; }
.lt-unit__units { flex-grow: 0; flex-basis: 90px; flex-shrink: 0; }

.lt-group { margin: 2px 0 4px 0; padding-left: 6px; border-left-width: 2px; border-left-color: var(--lt-border); }
.lt-group__title { color: var(--lt-dim); font-size: 11px; margin: 0 0 3px 0; padding: 0; }

/* Lists. */
.lt-list { margin-bottom: 4px; }
.lt-list__tools { flex-direction: row; }
.lt-list__header .lt-add--small { margin: 0 0 0 4px; height: 20px; padding: 0 8px; -unity-text-align: middle-center; }
.lt-add--quiet { background-color: transparent; border-color: var(--lt-border); color: var(--lt-dim); }
.lt-add--quiet:hover { background-color: var(--lt-card-hover); color: var(--lt-text); }
.lt-list__row--on { border-left-color: var(--lt-accent); background-color: var(--lt-accent-soft); }
.lt-list__row--override { border-left-color: var(--lt-green); }
.lt-list__drop { background-color: var(--lt-accent); }
.lt-list--bare .lt-list__row .lt-icon-btn--danger { display: none; }
.lt-list__row > .lt-row { margin-bottom: 0; }

.lt-style { margin-bottom: 2px; }
.lt-style__header { padding: 3px 4px; }
.lt-style__chevron { align-items: center; justify-content: center; margin-right: 2px; rotate: -90deg; }
.lt-style__chevron--open { rotate: 0deg; }
.lt-style__chevron .lt-icon { color: var(--lt-dim); }
.lt-style__tag { flex-shrink: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin: 0 5px 0 6px; }
.lt-style__type { flex-grow: 0; white-space: nowrap; min-width: 20px; }
.lt-style__what { color: var(--lt-faint); font-size: 10px; margin: 0 0 0 5px; padding: 0; flex-shrink: 2; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.lt-style__space { flex-grow: 1; flex-shrink: 1; min-width: 2px; }
.lt-style__driven { margin: 0 4px 0 2px; flex-shrink: 0; }
.lt-style__dot { width: 7px; height: 7px; border-radius: 4px; margin: 0 4px; flex-shrink: 0; background-color: var(--lt-faint); }

/* Lists of what can be chosen. */
.lt-palette__row { min-height: 20px; color: var(--lt-text); }
.lt-palette__row:hover { background-color: var(--lt-card-hover); }
.lt-palette__row--on, .lt-palette__row--on:hover { background-color: var(--lt-accent-soft); }
.lt-palette__name { color: var(--lt-text); font-size: 12px; margin: 0; padding: 0; }
.lt-palette__keys { color: var(--lt-dim); font-size: 10px; margin: 0 0 0 6px; padding: 0 5px; border-radius: 3px; background-color: var(--lt-inset); }
.lt-palette__group { margin: 0 0 0 6px; padding: 0; }
.lt-palette__parent { margin: 0 2px 4px 2px; }
.lt-palette__top { flex-direction: row; align-items: center; }
.lt-palette__top .lt-chip { margin: 0 4px 6px 0; }

/* The picker. */
.lt-picker { padding: 0; }
.lt-picker__head { flex-direction: row; align-items: center; margin-top: 4px; padding: 2px 2px; border-radius: 3px; }
.lt-picker__head:hover { background-color: var(--lt-card-hover); }
.lt-picker__chevron { color: var(--lt-dim); margin-right: 2px; }
.lt-picker__chevron--closed { rotate: -90deg; }
.lt-picker__group { margin: 0; padding: 0; color: var(--lt-dim); letter-spacing: 1px; opacity: 1; }
.lt-picker__group--flat { margin: 2px 0 2px 4px; }
.lt-picker__kind { color: var(--lt-faint); opacity: 1; margin: 4px 0 1px 18px; padding: 0; }
.lt-picker__item { flex-direction: column; justify-content: flex-start; padding: 3px 6px 3px 16px; }
.lt-picker__item:hover { background-color: var(--lt-card-hover); }
.lt-picker__item--on, .lt-picker__item--on:hover { background-color: var(--lt-accent-soft); }
.lt-picker__title { flex-direction: row; align-items: center; }
.lt-picker__name { color: var(--lt-text); font-size: 12px; margin: 0; padding: 0; }
.lt-picker__keys { color: var(--lt-accent); opacity: 1; margin: 0 4px 0 0; padding: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex-shrink: 1; }
.lt-picker__words { color: var(--lt-dim); font-size: 10px; margin: 0 0 0 15px; padding: 0; white-space: normal; }
.lt-picker .lt-style__dot { margin: 0 6px 0 2px; }
.lt-picker .lt-chip { margin: 0; }

/* The box of four sides. */
.lt-box__line { flex-direction: row; justify-content: center; }
.lt-box__side { flex-grow: 0; flex-basis: 110px; margin: 2px 4px; }
.lt-box__side > .lt-row__label { width: 40px; min-width: 40px; }
.lt-box__summary { color: var(--lt-text); background-color: var(--lt-inset); font-size: 11px; min-height: 20px; -unity-text-align: middle-left; border-radius: 5px; border-width: 1px; border-color: var(--lt-border); }
.lt-box__summary:hover { background-color: var(--lt-card-hover); }

.lt-fix { background-color: rgba(245, 165, 36, 0.12); border-left-color: var(--lt-orange); }
.lt-fix__text { color: var(--lt-orange); white-space: normal; margin: 0; padding: 0; min-width: 0; }
.lt-fix__button { color: var(--lt-text); background-color: var(--lt-inset); flex-shrink: 0; white-space: nowrap; }
.lt-fix__button:hover { background-color: var(--lt-accent-soft); }
.lt-problems { margin-top: 2px; }

.lt-vocab { margin-bottom: 3px; }

.lt-editor > .lt-chip { align-self: flex-start; margin: 4px 8px; white-space: normal; }

.lt-search .unity-base-text-field__input--placeholder,
.lt-search .unity-base-text-field__input--placeholder .unity-text-element { color: var(--lt-faint); }

.lt-root.lt--light { --lt-orange: #a86500; --lt-green: #0e8a55; --lt-red: #c7301e; }
.lt-vocab__tag:hover { color: var(--lt-accent); background-color: var(--lt-accent-soft); }

.lt-button { height: 24px; margin: 2px 0 6px 0; border-radius: 6px; border-width: 1px; border-color: var(--lt-accent-strong); background-color: var(--lt-accent-soft); color: var(--lt-accent); font-size: 11px; -unity-text-align: middle-center; cursor: link; }
.lt-button:hover { background-color: var(--lt-accent-strong); }

.lt-paint__slot {
    flex-direction: row;
    align-items: center;
    min-height: 18px;
    padding: 1px 4px;
    border-radius: 3px;
    background-color: var(--lt-inset);
    cursor: link;
    flex-shrink: 1;
    min-width: 0;
}
.lt-paint__slot:hover { background-color: var(--lt-card-hover); }
.lt-paint__swatch {
    width: 34px;
    height: 12px;
    flex-shrink: 0;
    margin-right: 6px;
    border-radius: 2px;
    border-width: 1px;
    border-color: var(--lt-border);
}
.lt-paint__swatch--none { border-color: var(--lt-faint); }
.lt-paint__words {
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--lt-text);
    font-size: 11px;
}
.lt-swatches { margin: 2px 0; }
.lt-swatches__row {
    flex-direction: row;
    align-items: center;
    padding: 3px 4px;
    border-radius: 3px;
    cursor: link;
}
.lt-swatches__row:hover { background-color: var(--lt-card-hover); }
.lt-swatches__row--on { background-color: var(--lt-accent-soft); }
.lt-choices__group {
    margin: 6px 0 2px 4px;
    font-size: 9px;
    -unity-font-style: bold;
    color: var(--lt-dim);
}
.lt-fold { margin: 1px 0; }
.lt-fold__head {
    flex-direction: row;
    align-items: center;
    min-height: 18px;
    cursor: link;
}
.lt-fold__title { flex-grow: 1; flex-shrink: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.lt-fold__body { padding-left: 8px; }
.lt-ref-row { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.lt-ref-row__head { flex-direction: row; align-items: center; min-height: 20px; }
.lt-ref-row__title { flex-grow: 1; flex-shrink: 1; min-width: 0; -unity-font-style: bold; overflow: hidden; text-overflow: ellipsis; }
.lt-vector { flex-direction: row; flex-grow: 1; flex-shrink: 1; min-width: 0; }
.lt-vector__axis { flex-grow: 1; flex-basis: 0; flex-shrink: 1; min-width: 0; margin: 0 2px 0 0; }
.lt-vector__axis .lt-row__label { min-width: 12px; width: 12px; flex-basis: auto; margin-right: 2px; }
.lt-event { margin: 2px 0; }
.lt-family { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.lt-family__head { margin-bottom: 2px; }
.lt-family__name { -unity-font-style: bold; }
.lt-family__facts { white-space: normal; }
.lt-answer--missing { color: var(--lt-red); }
.lt-axis { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.lt-glyph-grid { flex-direction: row; flex-wrap: wrap; margin-top: 4px; }
.lt-glyph-cell {
    width: 36px;
    height: 40px;
    margin: 0 3px 3px 0;
    border-radius: 3px;
    background-color: var(--lt-inset);
    color: var(--lt-text);
    cursor: link;
    -unity-text-align: middle-center;
}
.lt-glyph-cell:hover { background-color: var(--lt-accent-soft); }
.lt-glyph-cell--missing { color: var(--lt-red); cursor: arrow; }
.lt-find__row { color: var(--lt-text); font-size: 11px; padding: 2px 4px; cursor: link; white-space: normal; }
.lt-find__row:hover { background-color: var(--lt-card-hover); }
.lt-build { margin: 4px 0; }
.lt-build__item { margin-bottom: 3px; }
.lt-build__row { flex-direction: row; align-items: center; }
.lt-build__name { flex-grow: 1; flex-shrink: 1; min-width: 0; color: var(--lt-text); font-size: 11px; overflow: hidden; text-overflow: ellipsis; }
.lt-build__size { flex-shrink: 0; margin-left: 6px; color: var(--lt-dim); font-size: 10px; }
.lt-build__why { margin-left: 12px; color: var(--lt-dim); font-size: 10px; white-space: normal; }
.lt-rule__when { margin-bottom: 2px; }

/* Getting Started: a line with words that wrap and actions at the end. */
.lt-start { flex-direction: row; align-items: center; padding: 3px 0; }
.lt-start__words { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-right: 6px; }

/* A tree of folders that narrows a list, and the rows it narrows. */
.lt-tree__row { flex-direction: row; align-items: center; min-height: 20px; padding: 1px 4px; border-radius: 3px; cursor: link; }
.lt-tree__row:hover { background-color: var(--lt-card-hover); }
.lt-tree__row--on, .lt-tree__row--on:hover { background-color: var(--lt-accent-soft); }
.lt-tree__chevron { width: 12px; color: var(--lt-dim); margin: 0 2px 0 0; padding: 0; -unity-text-align: middle-center; }
.lt-tree__name { flex-grow: 1; flex-shrink: 1; min-width: 0; color: var(--lt-text); font-size: 11px; margin: 0; padding: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.lt-tree__row .lt-chip { margin: 0 0 0 4px; }
.lt-finding__head { flex-direction: row; align-items: center; }
.lt-finding__path { flex-grow: 1; flex-shrink: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.lt-finding--excluded { opacity: 0.55; }

/* ---------- Tag parameter panel, wrap list and the defaults form of a style card ---------- */

.lt-tagpanel {
    margin: 0 8px 8px 8px;
    padding: 6px 8px 6px 8px;
    border-radius: 6px;
    background-color: var(--lt-card);
    border-width: 1px;
    border-color: var(--lt-border);
}

.lt-tagpanel__head { flex-direction: row; align-items: center; flex-wrap: wrap; min-height: 22px; }
.lt-tagpanel__title { font-size: 10px; -unity-font-style: bold; letter-spacing: 1px; color: var(--lt-faint); margin: 0 8px 0 0; padding: 0; }
.lt-tagpanel__crumbs { flex-direction: row; flex-wrap: wrap; align-items: center; }
.lt-tagpanel__crumb { margin: 0 4px 0 0; padding: 2px 8px; font-size: 11px; }
.lt-tagpanel__label { margin: 0 4px 0 0; padding: 2px 8px; font-size: 11px; color: var(--lt-dim); }
.lt-tagpanel__space { flex-grow: 1; }
.lt-tagpanel__button { margin: 0 0 0 4px; padding: 2px 8px; font-size: 10px; }
.lt-tagpanel__effect { font-size: 10px; color: var(--lt-dim); margin: 0 0 0 6px; padding: 0; }
.lt-tagpanel__hintrow { flex-direction: row; align-items: center; flex-wrap: wrap; min-height: 28px; }
.lt-tagpanel__hint { font-size: 11px; margin: 0; flex-grow: 1; flex-shrink: 1; min-width: 120px; }
.lt-tagpanel__wrapbutton { margin: 2px 0 2px 8px; padding: 3px 10px; color: var(--lt-text); }
.lt-tagpanel__notice { margin: 6px 0 2px 0; }
.lt-tagpanel__raw { margin: 4px 0 2px 0; }
.lt-tagpanel__raw > .unity-base-text-field__input { white-space: normal; }
.lt-tagpanel__markup { flex-direction: row; flex-wrap: wrap; margin: 6px 0 4px 0; padding: 3px 6px; border-radius: 4px; background-color: var(--lt-inset); }
.lt-tagpanel__tok { font-size: 11px; color: var(--lt-dim); margin: 0; padding: 1px 0; }
.lt-tagpanel__tok--slot { color: var(--lt-accent); padding: 1px 1px; border-radius: 3px; }
.lt-tagpanel__tok--slot:hover { background-color: var(--lt-accent-soft); }
.lt-tagpanel__tok--on { color: #ffffff; background-color: var(--lt-accent); }
.lt-tagpanel__tok--empty { color: var(--lt-faint); }
.lt-tagpanel__signature { font-size: 10px; color: var(--lt-dim); margin: 4px 0 0 0; padding: 4px 0 0 0; border-top-width: 1px; border-top-color: var(--lt-border); white-space: normal; }
.lt-tagpanel__wrap { margin: 0; }
.lt-tagpanel__info { margin: 2px 0 4px 0; }
.lt-tagpanel__about { font-size: 11px; color: var(--lt-text); margin: 0 0 4px 0; padding: 0; white-space: normal; }
.lt-tagpanel__examples { flex-direction: column; flex-wrap: nowrap; align-items: flex-start; }
.lt-tagpanel__examplerow { flex-direction: row; flex-wrap: nowrap; align-items: center; }
.lt-tagpanel__trylabel { font-size: 10px; color: var(--lt-faint); margin: 0 6px 3px 0; padding: 0; }
.lt-tagpanel__example { margin: 0 4px 3px 0; padding: 2px 8px; font-size: 11px; align-self: flex-start; }
.lt-tagpanel__none { font-size: 11px; color: var(--lt-text); margin: 4px 0 2px 0; padding: 6px 8px; border-radius: 4px; background-color: var(--lt-inset); white-space: normal; }
.lt-tagpanel__why { font-size: 10px; color: var(--lt-dim); margin: 2px 0 4px 0; padding: 0; white-space: normal; }
.lt-tagpanel__part { margin: 0 0 4px 0; }
.lt-tagpanel__partname { font-size: 11px; color: var(--lt-text); margin: 0; padding: 0; -unity-font-style: bold; }
.lt-tagpanel__partwhat { font-size: 10px; color: var(--lt-dim); margin: 0 0 2px 0; padding: 0; white-space: normal; }
.lt-tagform__group { margin: 2px 0 0 0; }
.lt-tagform__grouphead { font-size: 10px; color: var(--lt-dim); margin: 2px 0 0 0; padding: 3px 6px; border-radius: 4px; border-width: 1px; border-color: var(--lt-border); }
.lt-tagform__grouphead:hover { color: var(--lt-text); background-color: var(--lt-card-hover); }
.lt-tagform__groupbody { margin: 2px 0 0 8px; }

.lt-tagform__rows { margin: 2px 0 0 0; }
.lt-tagform__extras { flex-direction: row; flex-wrap: wrap; margin-top: 2px; }
.lt-tagform__extra { margin: 0 4px 3px 0; }

.lt-slot { margin: 0 0 2px 0; padding: 0 2px; border-radius: 4px; border-width: 1px; border-color: rgba(0, 0, 0, 0); }
.lt-slot:hover { background-color: var(--lt-card-hover); }
.lt-slot--focus { border-color: var(--lt-accent); }
.lt-slot--focus .lt-slot__name { -unity-font-style: bold; color: var(--lt-text); }
.lt-slot--caret .lt-slot__badge { background-color: var(--lt-accent); color: #ffffff; }
.lt-slot__line { flex-direction: row; align-items: center; min-height: 28px; }
.lt-slot__badge { width: 16px; height: 16px; flex-shrink: 0; margin: 0 6px 0 0; padding: 0; border-radius: 8px; font-size: 9px; -unity-text-align: middle-center; color: var(--lt-dim); background-color: var(--lt-inset); }
.lt-slot__name { width: 76px; flex-shrink: 0; margin: 0; padding: 0; font-size: 11px; color: var(--lt-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.lt-slot__box { flex-grow: 1; flex-shrink: 1; min-width: 0; justify-content: center; }
.lt-slot__inherited { font-size: 11px; color: var(--lt-dim); margin: 0; padding: 4px 6px; border-radius: 4px; border-width: 1px; border-color: var(--lt-border); background-color: rgba(0, 0, 0, 0); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.lt-slot__inherited:hover { color: var(--lt-text); background-color: var(--lt-accent-soft); }
.lt-slot__set { flex-shrink: 0; margin: 0 0 0 6px; padding: 3px 0; width: 36px; border-radius: 4px; font-size: 10px; -unity-text-align: middle-center; color: var(--lt-dim); border-width: 1px; border-color: var(--lt-border); }
.lt-slot__set:hover { color: var(--lt-text); background-color: var(--lt-card-hover); }
.lt-slot__set--on, .lt-slot__set--on:hover { color: #ffffff; background-color: var(--lt-accent); border-color: var(--lt-accent); }
.lt-slot__reset { flex-shrink: 0; width: 20px; margin: 0 0 0 2px; padding: 2px 0; font-size: 12px; -unity-text-align: middle-center; color: var(--lt-dim); border-radius: 4px; }
.lt-slot__reset:hover { color: var(--lt-text); background-color: var(--lt-card-hover); }
.lt-slot__help { font-size: 10px; color: var(--lt-dim); margin: 0 0 5px 22px; padding: 0; white-space: normal; }
.lt-slot__unit { font-size: 11px; color: var(--lt-dim); margin: 0 0 0 4px; padding: 0; flex-shrink: 0; }
.lt-slot__note { font-size: 10px; margin: 0 0 3px 22px; padding: 2px 6px; border-radius: 4px; white-space: normal; color: var(--lt-red); background-color: rgba(240, 98, 114, 0.12); }
.lt-slot__note--warn { color: var(--lt-orange); background-color: rgba(245, 165, 36, 0.12); }
.lt-slot--invalid .lt-slot__box { border-width: 1px; border-color: var(--lt-red); border-radius: 5px; }
.lt-slot--clamped .lt-slot__box { border-width: 1px; border-color: var(--lt-orange); border-radius: 5px; }

.lt-slot__color, .lt-slot__number, .lt-slot__length, .lt-slot__choice, .lt-slot__bool, .lt-slot__textbox { flex-direction: row; align-items: center; flex-grow: 1; min-width: 0; }
.lt-slot__swatch { flex-grow: 1; flex-basis: 0; min-width: 36px; margin: 0 6px 0 0; }
.lt-slot__swatch > .unity-base-field__label { display: none; }
.lt-slot__hex { width: 90px; flex-shrink: 0; }
.lt-slot__slider { flex-grow: 1; flex-basis: 0; min-width: 40px; margin: 0 6px 0 0; }
.lt-slot__slider .unity-base-slider__tracker { height: 4px; border-radius: 2px; background-color: var(--lt-inset); border-width: 0; }
.lt-slot__slider .unity-base-slider__dragger { width: 12px; height: 12px; border-radius: 6px; background-color: var(--lt-accent); border-width: 0; margin-top: -4px; }
.lt-slot__slider .unity-base-slider__drag-container { height: 12px; }
.lt-slot__value { width: 62px; flex-shrink: 0; margin: 0; }
.lt-slot__length .lt-slot__value { flex-grow: 1; flex-basis: 0; min-width: 40px; margin-right: 6px; }
.lt-slot__units { flex-grow: 0; flex-shrink: 0; flex-basis: auto; }
.lt-slot__units .lt-seg__item { padding: 0 7px; flex-grow: 0; flex-shrink: 0; flex-basis: auto; min-width: 28px; }
.lt-slot__seg { flex-grow: 1; }
.lt-slot__raw { font-size: 10px; color: var(--lt-dim); margin: 0 0 0 6px; padding: 0; }
.lt-slot__text { flex-grow: 1; }
.lt-slot__bool .lt-switch { margin-right: 6px; }
.lt-slot__choice .lt-pick { flex-grow: 1; margin: 0; }

.lt-tool--wrap { color: var(--lt-accent); }

.lt-wrap { margin: 0 0 6px 0; padding: 6px; border-radius: 6px; background-color: var(--lt-card-hover); border-width: 1px; border-color: var(--lt-accent-strong); }
.lt-wrap__scroll { max-height: 220px; margin: 4px 0; }
.lt-wrap__group { font-size: 10px; -unity-font-style: bold; color: var(--lt-faint); margin: 4px 0 2px 2px; padding: 0; }
.lt-wrap__row { flex-direction: row; align-items: center; padding: 3px 6px; border-radius: 4px; min-height: 22px; }
.lt-wrap__row:hover { background-color: var(--lt-accent-soft); }
.lt-wrap__row--on, .lt-wrap__row--on:hover { background-color: var(--lt-accent-strong); }
.lt-wrap__row--dim { opacity: 0.55; }
.lt-wrap__tag { width: 110px; flex-shrink: 0; font-size: 11px; color: var(--lt-accent); margin: 0; padding: 0; overflow: hidden; text-overflow: ellipsis; }
.lt-wrap__name { flex-grow: 1; font-size: 11px; color: var(--lt-text); margin: 0; padding: 0; }
.lt-wrap__default { font-size: 10px; color: var(--lt-dim); margin: 0 6px; padding: 0; }
.lt-wrap__kind { width: 56px; flex-shrink: 0; font-size: 10px; color: var(--lt-dim); margin: 0; padding: 0; -unity-text-align: middle-right; }
.lt-wrap__info { color: var(--lt-orange); margin: 2px 2px; }
.lt-wrap__keys { margin: 2px 2px 0 2px; }
.lt-wrap__empty { margin: 6px 2px; }
.lt-wrap__plain { align-self: flex-start; margin: 0 2px; }
.lt-wrap__row, .lt-slot__set, .lt-slot__reset, .lt-slot__inherited, .lt-tagpanel__wrapbutton, .lt-tagpanel__tok--slot, .lt-defaults__rawtoggle, .lt-tagform__grouphead, .lt-tagpanel__example { cursor: link; }

.lt-defaults { margin: 2px 0 4px 0; padding: 4px 0 2px 6px; border-left-width: 2px; border-left-color: var(--lt-border); }
.lt-defaults__head { flex-direction: row; align-items: center; flex-wrap: wrap; margin-bottom: 3px; }
.lt-defaults__title { width: auto; min-width: 0; margin-right: 8px; -unity-font-style: bold; color: var(--lt-text); }
.lt-defaults__sub { margin: 0; }
.lt-defaults__foot { flex-direction: row; align-items: center; margin-top: 2px; }
.lt-defaults__summary { font-size: 11px; color: var(--lt-text); margin: 0; padding: 0; flex-shrink: 1; white-space: normal; }
.lt-defaults__filled { margin: 2px 0 0 0; }
.lt-defaults__error { margin: 0 0 4px 0; }
.lt-defaults__rawtoggle { margin: 0; }
